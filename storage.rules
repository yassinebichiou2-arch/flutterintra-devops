rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos — owner can write, all authenticated users can read
    match /profile_photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024  // 5MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Post images — authenticated users can upload, all can read
    match /post_images/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Post files — authenticated users can upload, all can read
    match /post_files/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Chat files — authenticated users can upload, all can read
    match /chat_files/{convId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }
  }
}
